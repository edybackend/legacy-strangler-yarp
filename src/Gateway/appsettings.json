{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "customers": { "ClusterId": "shop", "Match": { "Path": "/api/customers/{**rest}", "Methods": [ "GET" ] } },
      "orders-read": { "ClusterId": "shop", "Match": { "Path": "/api/orders/{**rest}", "Methods": [ "GET" ] } },
      "orders-write": { "ClusterId": "shop", "Match": { "Path": "/api/orders/{**rest}", "Methods": [ "POST" ] } }
    },
    "Clusters": {
      "shop": {
        "Destinations": {
          "legacy": { "Address": "http://localhost:8081/" },
          "modern": { "Address": "http://localhost:8082/" }
        }
      }
    }
  },
  "Migration": {
    "Routes": {
      "customers": { "Mode": "Modern", "ModernReady": true, "ReadOnly": true },
      "orders-read": { "Mode": "Shadow", "ModernReady": true, "ReadOnly": true },
      "orders-write": { "Mode": "Legacy", "ModernReady": false, "ReadOnly": false }
    }
  }
}
